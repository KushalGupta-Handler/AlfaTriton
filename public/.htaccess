# Alfa Triton — Apache config for cPanel hosting
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS + www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.alfatriton.com.au%{REQUEST_URI} [L,R=301]

  # 301s from the old site so existing Google rankings carry over
  RewriteRule ^about_alfa_triton\.html$        /#why [NE,L,R=301]
  RewriteRule ^our_history\.html$              /#why [NE,L,R=301]
  RewriteRule ^quality_guarantee\.html$        /#why [NE,L,R=301]
  RewriteRule ^location\.html$                 /#area [NE,L,R=301]
  RewriteRule ^our_services\.html$             /#services [NE,L,R=301]
  RewriteRule ^technologies\.html$             /#capabilities [NE,L,R=301]
  RewriteRule ^cnc_turning\.html$              /#service-cnc [NE,L,R=301]
  RewriteRule ^milling\.html$                  /#service-cnc [NE,L,R=301]
  RewriteRule ^gear_cutting\.html$             /#service-gears [NE,L,R=301]
  RewriteRule ^sheet_metal_fabrication\.html$  /#service-fabrication [NE,L,R=301]
  RewriteRule ^welding\.html$                  /#service-welding [NE,L,R=301]
  RewriteRule ^cad_solidworks\.html$           /#service-design [NE,L,R=301]
  RewriteRule ^projects\.html$                 /#projects [NE,L,R=301]
  RewriteRule ^contact\.html$                  /#contact [NE,L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(js|css|woff2|webp|avif|jpg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/xml
</IfModule>

AddType video/mp4 .mp4
AddType image/webp .webp
AddType font/woff2 .woff2
