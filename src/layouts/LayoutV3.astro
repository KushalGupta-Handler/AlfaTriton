---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/v3.css';
import HeaderV3 from '../components/v3/HeaderV3.astro';
import FooterV3 from '../components/v3/FooterV3.astro';
import GearStageV3 from '../components/v3/GearStageV3.astro';
import GearStageV4 from '../components/v3/GearStageV4.astro';
import WeldStage from '../components/v3/WeldStage.astro';
import VersionSwitch from '../components/VersionSwitch.astro';
import { site, faqs } from '../data/site';

interface Props { title?: string; description?: string; review?: boolean; gear?: 'roll' | 'assembly' | 'weld' | 'none'; version?: 'v3' | 'v4' | 'v5' }
const {
  title = `${site.name} | Precision Engineering & 24/7 Breakdown Repairs, Sydney`,
  description = site.description,
  review = true,
  gear = 'roll',
  version = 'v3',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og-image.jpg', site.url).href;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness', '@id': `${site.url}/#business`, name: site.name, legalName: site.legalName, url: site.url,
      image: ogImage, description: site.description, foundingDate: String(site.founded), telephone: site.phone.tel,
      address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.locality, addressRegion: site.address.region, postalCode: site.address.postcode, addressCountry: site.address.country },
      geo: { '@type': 'GeoCoordinates', latitude: site.address.geo.lat, longitude: site.address.geo.lng },
      areaServed: site.serviceArea.map((name) => ({ '@type': 'Place', name })),
    },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
});
---
<!doctype html>
<html lang="en-AU" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Design candidate: keep out of Google until chosen as the live version -->
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0d0f12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <HeaderV3 />
    {gear === 'assembly' ? <GearStageV4 /> : gear === 'roll' ? <GearStageV3 /> : gear === 'weld' ? <WeldStage /> : null}
    <main id="main"><slot /></main>
    <FooterV3 review={review} />
    {review && <VersionSwitch current={version} />}
    <script>import '../scripts/v3';</script>
  </body>
</html>
