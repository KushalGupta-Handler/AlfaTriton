---
const steps = [
  { t: 'Call or send the job', d: 'Phone, or use the quote form to send drawings, photos or the worn part. Urgent breakdowns go straight to the on-call team.' },
  { t: 'Measure & diagnose', d: 'We come to site to inspect and measure up — or assess the part in our workshop.' },
  { t: 'Design in CAD', d: 'Parts and assemblies are modelled and checked in SolidWorks. Drawings supplied if you need them.' },
  { t: 'Machine & fabricate', d: 'Turned, milled, gear cut, fabricated and welded in-house — then tested to Australian Standards.' },
  { t: 'Install & support', d: 'Installed and commissioned on site, backed by a 12-month warranty and our 24/7 line.' },
];
---
<section class="section section--steel" id="process" aria-labelledby="process-title">
  <div class="container process">
    <header class="section-head reveal process__head">
      <p class="eyebrow">How we work</p>
      <h2 id="process-title">From breakdown to <span class="accent">back online</span></h2>
      <p>A simple, accountable process — one team, one workshop, no hand-offs between subcontractors.</p>
      <a href="#quote" class="btn">Start with step one</a>
    </header>
    <ol class="steps" data-steps style="--fill: 0">
      <span class="steps__rail" aria-hidden="true"><span></span></span>
      {steps.map((s, i) => (
        <li class="step reveal">
          <span class="step__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { display: grid; gap: 8px; }
  @media (min-width: 1024px) { .process { grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: start; } .process__head { position: sticky; top: calc(var(--header-h) + 40px); } }
  .process__head .btn { margin-top: 24px; }
  .steps { list-style: none; margin: 0; padding: 0 0 0 4px; position: relative; display: grid; gap: 28px; }
  .steps__rail { position: absolute; left: 27px; top: 10px; bottom: 10px; width: 2px; background: var(--steel-300); }
  .steps__rail span { display: block; width: 100%; height: 100%; background: var(--grad-blue); transform-origin: top; transform: scaleY(var(--fill)); }
  .step { display: grid; grid-template-columns: 48px 1fr; gap: 18px; position: relative; }
  .step__n {
    width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%;
    background: var(--white); border: 2px solid var(--steel-300); position: relative; z-index: 1;
    font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; color: var(--blue-600);
    transition: background 0.4s, border-color 0.4s, color 0.4s;
  }
  .step.is-in .step__n { border-color: var(--blue-500); }
  .step h3 { font-size: 1.5rem; margin: 10px 0 6px; }
  .step p { color: var(--text-muted); margin: 0; font-size: 0.95rem; }
</style>
