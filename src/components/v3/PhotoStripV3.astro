---
import { Image } from 'astro:assets';
import rolls from '../../assets/photos/drive-rolls.jpg';
import shaft from '../../assets/photos/gear-splined-shaft.jpg';
import pipework from '../../assets/photos/stainless-pipework.jpg';
import tray from '../../assets/photos/stainless-tray.jpg';
import after from '../../assets/photos/machine-after.jpg';
import flange from '../../assets/photos/flange.jpg';
import weld from '../../assets/photos/weld-detail.jpg';
import turned from '../../assets/photos/turned-part.jpg';

const photos = [
  { src: rolls, alt: 'Knurled drive rolls machined by Alfa Triton' },
  { src: pipework, alt: 'TIG-welded stainless steel pipework' },
  { src: shaft, alt: 'Gear with splined shaft' },
  { src: after, alt: 'Restored production machine' },
  { src: tray, alt: 'Stainless steel fabricated tray' },
  { src: flange, alt: 'Precision machined flange' },
  { src: weld, alt: 'Weld detail on steel fabrication' },
  { src: turned, alt: 'CNC turned part' },
];
---
<section class="strip" data-gear="D,50,0.5,0.20" data-gear-m="D,50,0.85,0.32" aria-label="Recent work from our workshop">
  <div class="wrap strip__head">
    <p class="label"><b>/</b> Real work from our Clyde workshop</p>
    <span class="nu">[Need update from Oliver: higher-res job photos]</span>
  </div>
  <div class="strip__rail" data-marquee>
    <ul class="strip__track" role="list">
      {[...photos, ...photos].map((p, i) => (
        <li aria-hidden={i >= photos.length ? 'true' : undefined}>
          <Image src={p.src} alt={i >= photos.length ? '' : p.alt} widths={[280, 420]} sizes="240px" format="webp" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .strip { position: relative; padding: 8px 0 clamp(64px, 12vw, 120px); }
  .strip__head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-bottom: 18px; }
  .strip__head .label { margin: 0; }
  .strip__rail { position: relative; z-index: 2; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .strip__track { display: flex; gap: 12px; width: max-content; list-style: none; margin: 0; padding: 0; animation: marquee 60s linear infinite; }
  .strip__rail:hover .strip__track { animation-play-state: paused; }
  .strip li { width: 220px; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: var(--bg-3); flex: none; }
  @media (min-width: 768px) { .strip li { width: 280px; } }
  .strip li :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.9); transition: filter 0.4s, transform 0.6s var(--ease); }
  .strip li:hover :global(img) { filter: saturate(1.1); transform: scale(1.04); }
  @keyframes marquee { to { transform: translateX(calc(-50% - 6px)); } }
  @media (prefers-reduced-motion: reduce) {
    .strip__rail { overflow-x: auto; }
    .strip__track { animation: none; }
  }
</style>
