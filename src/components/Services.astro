---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';
import { services } from '../data/site';
import welding from '../assets/photos/welding-onsite.jpg';
import turned from '../assets/photos/cnc-milling.jpg';
import gear from '../assets/photos/gear-splined-shaft.jpg';
import tray from '../assets/photos/stainless-tray.jpg';
import weld from '../assets/photos/weld-detail.jpg';
import mixer from '../assets/photos/mixer-cad.jpg';

const img: Record<string, ImageMetadata> = { breakdown: welding, cnc: turned, gears: gear, fabrication: tray, welding: weld, design: mixer };
---
<section class="section" id="services" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">Capabilities</p>
      <h2 id="services-title">Everything under <span class="accent">one roof</span></h2>
      <p>Design, machining, fabrication, welding and installation — all in-house in Western Sydney, so there's one team accountable from first measurement to start-up.</p>
    </header>
  </div>

  <div class="services-scroller" data-scroller>
    <ul class="services" role="list">
      {services.map((s, i) => (
        <li class="service reveal" style={`--d:${(i % 3) * 0.08}s`} id={`service-${s.id}`}>
          <Photo src={img[s.id]} alt={`${s.title} by Alfa Triton Engineering`} class="service__img" widths={[400, 640]} sizes="(min-width: 1024px) 380px, 82vw" />
          <div class="service__body">
            <span class="service__icon"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <ul class="service__points" role="list">
              {s.points.map((pt) => <li><Icon name="check" />{pt}</li>)}
            </ul>
            <a href="#quote" class="link-arrow" data-service={s.formValue}>Get a quote <Icon name="arrow" /></a>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div class="container services__hint" aria-hidden="true"><span>Swipe</span><span class="services__bar"><span data-scroller-bar></span></span></div>
</section>

<style>
  .services-scroller { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 8px; scroll-padding-inline: var(--gutter); }
  .services-scroller::-webkit-scrollbar { display: none; }
  .services { display: grid; grid-auto-flow: column; grid-auto-columns: 82%; gap: 14px; list-style: none; margin: 0; padding: 4px var(--gutter) 12px; }
  @media (min-width: 640px) { .services { grid-auto-columns: 46%; } }
  .service {
    scroll-snap-align: start; display: flex; flex-direction: column;
    background: var(--white); border: 1px solid var(--steel-200); border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow-1); transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .service:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
  .service :global(.service__img) { aspect-ratio: 16 / 10; }
  .service :global(.service__img img) { transition: transform 0.8s var(--ease); }
  .service:hover :global(.service__img img) { transform: scale(1.05); }
  .service__body { position: relative; padding: 34px 20px 22px; display: flex; flex-direction: column; flex: 1; }
  .service__icon {
    position: absolute; top: -26px; left: 20px; width: 52px; height: 52px; border-radius: var(--radius-sm);
    display: grid; place-items: center; background: var(--grad-blue); color: var(--white); box-shadow: 0 8px 20px rgba(18,135,194,0.35);
  }
  .service__icon :global(svg) { width: 26px; height: 26px; }
  .service h3 { font-size: 1.55rem; margin-bottom: 8px; }
  .service p { color: var(--text-muted); font-size: 0.95rem; }
  .service__points { list-style: none; padding: 0; margin: 0 0 18px; display: grid; gap: 6px; font-size: 0.88rem; flex: 1; }
  .service__points li { display: flex; gap: 8px; align-items: flex-start; }
  .service__points :global(svg) { width: 16px; height: 16px; color: var(--blue-500); flex: none; margin-top: 3px; }

  .services__hint { display: flex; align-items: center; gap: 12px; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--steel-500); margin-top: 8px; }
  .services__bar { flex: 1; height: 2px; background: var(--steel-200); border-radius: 2px; overflow: hidden; }
  .services__bar span { display: block; height: 100%; width: 30%; background: var(--blue-500); transform-origin: left; transition: transform 0.1s linear; }

  @media (min-width: 1024px) {
    .services-scroller { overflow: visible; max-width: var(--maxw); margin-inline: auto; padding-inline: var(--gutter); }
    .services { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); grid-auto-columns: auto; gap: 24px; padding: 0; }
    .services__hint { display: none; }
  }
</style>
