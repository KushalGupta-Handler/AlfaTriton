---
// Review-only switch between design versions. Remove once a version is chosen.
interface Props { current: 'v1' | 'v2' }
const { current } = Astro.props;
---
<nav class="vswitch" aria-label="Design version">
  <span class="vswitch__lbl">Design</span>
  <a href="/" aria-current={current === 'v1' ? 'page' : undefined}>V1</a>
  <a href="/v2/" aria-current={current === 'v2' ? 'page' : undefined}>V2</a>
</nav>

<style>
  .vswitch {
    position: fixed; right: 0; top: 50%; z-index: 150; transform: translateY(-50%);
    display: inline-flex; flex-direction: column; align-items: center; gap: 2px; padding: 4px;
    border-right: 0 !important; border-radius: 12px 0 0 12px !important;
    background: rgba(13, 15, 18, 0.88); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 999px;
    font: 600 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace; color: #eef1f4;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .vswitch__lbl { writing-mode: vertical-rl; padding: 6px 0; color: #8d97a1; text-transform: uppercase; letter-spacing: 0.08em; font-size: 10px; }
  .vswitch a { padding: 8px 7px; border-radius: 8px; text-decoration: none; }
  .vswitch a[aria-current='page'] { background: #1b9fd9; color: #fff; }
  .vswitch a:not([aria-current]):hover { background: rgba(255, 255, 255, 0.1); }
</style>
