---
// Review-only switch between design versions. Remove once a version is chosen.
// Shown only near the top of the page so it never covers content while reading.
interface Props { current: 'v1' | 'v2' | 'v3' | 'v4' }
const { current } = Astro.props;
const versions = [
  { id: 'v1', href: '/v1/' },
  { id: 'v2', href: '/v2/' },
  { id: 'v3', href: '/' },
  { id: 'v4', href: '/v4/' },
];
---
<nav class="vswitch" aria-label="Design version" data-vswitch>
  <span class="vswitch__lbl">Design</span>
  {versions.map((v) => <a href={v.href} aria-current={current === v.id ? 'page' : undefined}>{v.id.toUpperCase()}</a>)}
</nav>
<script is:inline>
  (function () {
    var el = document.querySelector('[data-vswitch]');
    if (!el) return;
    var f = function () { el.classList.toggle('is-away', window.scrollY > 80); };
    window.addEventListener('scroll', f, { passive: true });
    f();
  })();
</script>

<style>
  .vswitch {
    position: fixed; right: 12px; top: 112px; z-index: 150;
    display: inline-flex; align-items: center; gap: 2px; padding: 4px;
    background: rgba(13, 15, 18, 0.88); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 999px;
    font: 600 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace; color: #eef1f4;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: opacity 0.3s, transform 0.3s;
  }
  .vswitch.is-away { opacity: 0; transform: translateY(-8px); pointer-events: none; }
  .vswitch__lbl { padding: 0 6px 0 8px; color: #8d97a1; text-transform: uppercase; letter-spacing: 0.08em; font-size: 10px; }
  .vswitch a { padding: 7px 10px; border-radius: 999px; text-decoration: none; color: inherit; }
  .vswitch a[aria-current='page'] { background: #1b9fd9; color: #fff; }
  .vswitch a:not([aria-current]):hover { background: rgba(255, 255, 255, 0.1); }
</style>
