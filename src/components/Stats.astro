---
import { site, yearsInBusiness } from '../data/site';
const stats = [
  { n: yearsInBusiness, suffix: '', label: 'Years in business', sub: `Since ${site.founded}` },
  { n: 24, suffix: '/7', label: 'Breakdown response', sub: 'On site or in the shop' },
  { n: 2, suffix: ' m', label: 'Max gear diameter', sub: 'Internal gears to 1 m' },
  { n: site.warrantyMonths, suffix: ' mo', label: 'Product warranty', sub: 'On all Alfa Triton work' },
];
---
<section class="stats on-dark" aria-label="Alfa Triton at a glance">
  <div class="container">
    <dl class="stats__grid">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`--d:${i * 0.08}s`}>
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="stat__num"><span data-count={s.n}>{s.n}</span>{s.suffix}</span>
            <span class="stat__label">{s.label}</span>
            <span class="stat__sub">{s.sub}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats { background: var(--ink); color: var(--text-inv); border-top: 1px solid rgba(255,255,255,0.06); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .stats__grid { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; }
  @media (min-width: 900px) { .stats__grid { grid-template-columns: repeat(4, 1fr); } }
  .stat { padding: 28px 8px 28px 0; border-bottom: 1px solid rgba(255,255,255,0.07); position: relative; }
  .stat:nth-child(odd) { padding-right: 16px; border-right: 1px solid rgba(255,255,255,0.07); }
  .stat:nth-child(even) { padding-left: 16px; }
  @media (min-width: 900px) {
    .stat, .stat:nth-child(odd), .stat:nth-child(even) { padding: 40px 24px; border-bottom: 0; border-right: 1px solid rgba(255,255,255,0.07); }
    .stat:first-child { padding-left: 0; }
    .stat:last-child { border-right: 0; }
  }
  .stat dd { margin: 0; display: grid; gap: 2px; }
  .stat__num {
    font-family: var(--font-display); font-weight: 800; font-size: clamp(2.8rem, 10vw, 4.4rem); line-height: 1;
    background: linear-gradient(180deg, #fff 30%, #9fb4c4); -webkit-background-clip: text; background-clip: text; color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .stat__label { font-weight: 600; color: var(--white); font-size: 0.95rem; margin-top: 6px; }
  .stat__sub { font-size: 0.82rem; color: var(--text-inv-muted); }
</style>
