---
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <header class="section-head reveal">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Straight <span class="accent">answers</span></h2>
      <p>The questions plant and maintenance managers ask us most. Can't see yours? Call the workshop on <a href="tel:+61296422899">02 9642 2899</a>.</p>
    </header>
    <div class="faq__list">
      {faqs.map((f, i) => (
        <details class="faq__item reveal" open={i === 0}>
          <summary><h3>{f.q}</h3><span class="faq__icon"><Icon name="plus" /></span></summary>
          <div class="faq__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; gap: 8px; }
  @media (min-width: 1024px) { .faq { grid-template-columns: 0.8fr 1.2fr; gap: 64px; align-items: start; } }
  .faq__item { border-bottom: 1px solid var(--steel-200); }
  .faq__item:first-child { border-top: 1px solid var(--steel-200); }
  summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-family: var(--font-body); text-transform: none; font-size: 1.05rem; font-weight: 600; line-height: 1.4; margin: 0; letter-spacing: 0; }
  .faq__icon { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--steel-100); color: var(--blue-600); transition: transform 0.3s var(--ease), background 0.3s; }
  .faq__icon :global(svg) { width: 18px; height: 18px; }
  details[open] .faq__icon { transform: rotate(45deg); background: var(--blue-500); color: var(--white); }
  .faq__a p { color: var(--text-muted); margin: 0 0 20px; max-width: 64ch; }
</style>
