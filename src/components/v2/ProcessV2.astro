---
import { site } from '../../data/site';
const steps = [
  { t: 'Call or send a photo', d: 'Ring us, or send a photo of the part or a drawing. Breakdowns go straight to the on-call crew.', time: '5 minutes' },
  { t: 'We measure & quote', d: 'We inspect on site or in our workshop, then give you a clear price and lead time.', time: 'Same / next day', nu: true },
  { t: 'We make it in-house', d: 'Modelled in SolidWorks, then machined, cut, fabricated and welded under one roof.', time: 'Days, not weeks', nu: true },
  { t: 'Installed & guaranteed', d: `Fitted and commissioned on site, backed by a ${site.warrantyMonths}-month warranty.`, time: `${site.warrantyMonths}-month warranty` },
];
---
<section class="sec pr" id="process" data-gear="86,50,0.66,0.26" data-gear-m="90,30,0.7,0.16" aria-labelledby="pr-h">
  <div class="wrap">
    <div class="pr__head">
      <p class="label rv"><b>/ 02</b> — How we work</p>
      <h2 id="pr-h" class="split" data-split><span><span>From breakdown</span></span><span><span style="--i:1" class="hl">to back online.</span></span></h2>
    </div>
    <ol class="pr__steps" role="list" data-rail style="--fill:0">
      <span class="pr__rail" aria-hidden="true"><span></span></span>
      {steps.map((s, i) => (
        <li class="pr__step rv" style={`--d:${i * 0.1}s`}>
          <span class="pr__dot" aria-hidden="true"></span>
          <span class="pr__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <span class="pr__time">{s.time}{s.nu && <> <span class="nu">[Need update from Oliver: confirm]</span></>}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pr__head { max-width: 760px; margin-bottom: clamp(40px, 7vw, 80px); }
  .pr__steps { list-style: none; margin: 0; padding: 0 0 0 28px; position: relative; display: grid; gap: 44px; }
  .pr__rail { position: absolute; left: 5px; top: 8px; bottom: 8px; width: 1px; background: var(--line-2); }
  .pr__rail span { position: absolute; inset: 0; background: var(--grad); transform-origin: top; transform: scaleY(var(--fill)); }
  .pr__step { position: relative; }
  .pr__dot { position: absolute; left: -28px; top: 6px; width: 11px; height: 11px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--blue-hi); }
  .pr__step.in .pr__dot { background: var(--blue-hi); box-shadow: 0 0 0 5px rgba(72, 193, 240, 0.15); }
  .pr__n { display: block; font-family: var(--f-mono); font-size: 0.78rem; color: var(--blue-hi); margin-bottom: 10px; }
  .pr__step h3 { margin-bottom: 10px; }
  .pr__step p { color: var(--fg-2); margin-bottom: 12px; max-width: 34ch; }
  .pr__time { font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-3); }

  @media (min-width: 1024px) {
    .pr__steps { grid-template-columns: repeat(4, 1fr); gap: 32px; padding: 34px 0 0; }
    .pr__rail { left: 0; right: 0; top: 5px; bottom: auto; width: auto; height: 1px; }
    .pr__rail span { transform-origin: left; transform: scaleX(var(--fill)); }
    .pr__dot { left: 0; top: -34px; }
  }
</style>
