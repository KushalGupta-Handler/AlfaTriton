---
import Icon from './Icon.astro';
import NeedsUpdate from './NeedsUpdate.astro';
import { industries } from '../data/site';
const ticker = ['Food & Beverage', 'Pharmaceutical', 'Packaging', 'Printing', 'Rail', 'Steel', 'Transport', 'Engineering Workshops'];
---
<section class="section section--ink blueprint" id="industries" aria-labelledby="industries-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">Industries</p>
      <h2 id="industries-title">Trusted on the <span class="accent">factory floor</span></h2>
      <p>We know production environments — hygiene standards, tight shutdown windows and the cost of every hour a line stands still.</p>
    </header>
    <ul class="ind-grid" role="list">
      {industries.map((ind, i) => (
        <li class="ind reveal" style={`--d:${(i % 3) * 0.08}s`}>
          <span class="ind__icon"><Icon name={ind.icon} /></span>
          <h3>{ind.title}</h3>
          <p>{ind.copy}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => ticker.map((t) => <span>{t}<i></i></span>))}
    </div>
  </div>

  <div class="container clients reveal">
    <p class="clients__label">Servicing Australia's premier manufacturers <NeedsUpdate note="client logos (with permission)" /></p>
    <ul class="clients__row" role="list">
      {Array.from({ length: 6 }).map((_, i) => <li class="clients__logo">Client logo {i + 1}</li>)}
    </ul>
  </div>
</section>

<style>
  .ind-grid { display: grid; gap: 1px; list-style: none; padding: 0; margin: 0; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius); overflow: hidden; }
  @media (min-width: 640px) { .ind-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .ind-grid { grid-template-columns: repeat(3, 1fr); } }
  .ind { background: var(--ink); padding: 26px 22px; position: relative; transition: background 0.3s var(--ease); }
  .ind:hover { background: var(--char-900); }
  .ind::after { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--grad-blue); transform: scaleY(0); transform-origin: top; transition: transform 0.4s var(--ease); }
  .ind:hover::after { transform: scaleY(1); }
  .ind__icon { display: inline-grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(24,166,220,0.4); color: var(--blue-400); margin-bottom: 14px; }
  .ind__icon :global(svg) { width: 22px; height: 22px; }
  .ind h3 { font-size: 1.5rem; color: var(--white); margin-bottom: 6px; }
  .ind p { font-size: 0.93rem; margin: 0; }

  .ticker { margin-top: clamp(48px, 8vw, 80px); overflow: hidden; border-block: 1px solid rgba(255,255,255,0.08); padding-block: 18px; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .ticker__track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .ticker span { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.8rem, 6vw, 3rem); color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.35); white-space: nowrap; }
  .ticker span:nth-child(3n+1) { color: rgba(255,255,255,0.9); -webkit-text-stroke: 0; }
  .ticker i { width: 18px; height: 12px; background: var(--grad-blue); clip-path: polygon(30% 0, 70% 0, 100% 100%, 0 100%); }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .clients { margin-top: 40px; }
  .clients__label { font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-inv-muted); text-align: center; }
  .clients__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; list-style: none; padding: 0; margin: 16px 0 0; }
  @media (min-width: 900px) { .clients__row { grid-template-columns: repeat(6, 1fr); } }
  .clients__logo { display: grid; place-items: center; height: 64px; border: 1px dashed rgba(255,255,255,0.18); border-radius: var(--radius-sm); font-size: 0.75rem; color: var(--steel-500); }
</style>
