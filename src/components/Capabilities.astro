---
import NeedsUpdate from './NeedsUpdate.astro';
const tabs = [
  {
    id: 'welding', label: 'Welding',
    intro: 'TIG for stainless and aluminium; MIG for mild steel and heavy fabrication. Workshop or on site.',
    head: ['Process', 'Material', 'Thickness (mm)', 'Weld size (mm)'],
    rows: [
      ['TIG', 'Stainless', '0.5–16', '0.5–12'],
      ['TIG', 'Mild steel', '0.9–16', '0.9–12'],
      ['TIG', 'Aluminium', '0.9–20', '0.9–16'],
      ['MIG', 'Mild steel', '0.9–30', '2–16'],
      ['MIG', 'Stainless', '0.5–20', '1.5–16'],
      ['MIG', 'Aluminium', '1.2–20', '2–16'],
    ],
  },
  {
    id: 'gears', label: 'Gear cutting',
    intro: 'Overhaul of industrial gearboxes and reverse engineering of hard-to-source gears.',
    head: ['Capability', 'Range'],
    rows: [
      ['External gears', 'Up to 2,000 mm diameter'],
      ['Internal gears', 'Up to 1,000 mm diameter'],
      ['Gear types', 'Spur, helical, bevel, worm, internal & external spline'],
      ['Testing (NDT)', 'Ultrasonic · magnetic particle inspection (MPI)'],
    ],
  },
  {
    id: 'machining', label: 'Machining',
    intro: 'Prototype, small, medium and large quantity orders — all machined in-house.',
    head: ['Machine', 'Notes'],
    rows: [
      ['Mazak Quickturn 15N CNC lathe', 'Mazatrol T32-2 control'],
      ['Romac milling machine', 'Milling & boring'],
      ['SolidWorks CAD', 'Design, drawings & load simulation'],
      ['Full equipment list', '__NU__'],
    ],
  },
  {
    id: 'materials', label: 'Materials',
    intro: 'We machine, fabricate and weld a wide range of metals and engineering plastics.',
    head: ['Material', 'Typical use'],
    rows: [
      ['Stainless steel', 'Food & pharma equipment, pipework, hoppers'],
      ['Alloy & mild steel', 'Shafts, gears, frames, structures'],
      ['Aluminium', 'Lightweight guards, brackets, fabrication'],
      ['Brass, copper & bronze', 'Bushes, fittings, wear parts'],
      ['Cast iron', 'Repair welding of housings & castings'],
      ['PVC & plastics', 'Wear strips, guides, spacers'],
    ],
  },
];
---
<section class="section" id="capabilities" aria-labelledby="cap-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">Spec sheet</p>
      <h2 id="cap-title">The numbers <span class="accent">engineers ask for</span></h2>
      <p>Capacities and materials at a glance. Not sure if we can do it? Send the drawing — the answer is usually yes.</p>
    </header>

    <div class="spec reveal" data-tabs>
      <div class="spec__tabs" role="tablist" aria-label="Capability categories">
        {tabs.map((t, i) => (
          <button role="tab" type="button" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
        ))}
      </div>
      {tabs.map((t, i) => (
        <div class="spec__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} tabindex="0">
          <p class="spec__intro">{t.intro}</p>
          <div class="spec__table-wrap">
            <table>
              <thead><tr>{t.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>
                {t.rows.map((r) => (
                  <tr>{r.map((c, j) => (j === 0 ? <th scope="row">{c}</th> : <td>{c === '__NU__' ? <NeedsUpdate note="list all machines" /> : c}</td>))}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .spec { border: 1px solid var(--steel-200); border-radius: var(--radius-lg); overflow: hidden; background: var(--white); box-shadow: var(--shadow-1); }
  .spec__tabs { display: flex; overflow-x: auto; scrollbar-width: none; background: var(--steel-100); border-bottom: 1px solid var(--steel-200); }
  .spec__tabs::-webkit-scrollbar { display: none; }
  .spec__tabs button {
    flex: 1 0 auto; min-height: 56px; padding: 0 20px; border: 0; background: none; cursor: pointer; white-space: nowrap;
    font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--steel-500);
    border-bottom: 3px solid transparent; transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .spec__tabs button[aria-selected='true'] { color: var(--blue-700); border-bottom-color: var(--blue-500); background: var(--white); }
  .spec__panel { padding: 22px 18px 24px; }
  @media (min-width: 768px) { .spec__panel { padding: 32px; } }
  .spec__intro { color: var(--text-muted); }
  .spec__table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.86rem; font-variant-numeric: tabular-nums; }
  @media (min-width: 768px) { table { font-size: 0.95rem; } th, td { padding: 12px 14px !important; } }
  tbody td { white-space: nowrap; }
  #panel-gears td, #panel-machining td, #panel-materials td { white-space: normal; }
  th, td { text-align: left; padding: 11px 8px; border-bottom: 1px solid var(--steel-200); vertical-align: top; }
  thead th { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--steel-500); font-weight: 600; border-bottom: 2px solid var(--steel-300); }
  tbody th { font-weight: 600; }
  tbody tr:hover { background: var(--steel-100); }
  :global(.no-js) .spec__panel[hidden] { display: block; }
</style>
