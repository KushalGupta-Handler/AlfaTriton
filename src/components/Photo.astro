---
// Optimised responsive image + optional "update from Oliver" badge.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  badge?: string | false;
  fetchpriority?: 'high' | 'low' | 'auto';
}
const {
  src, alt, widths = [400, 640, 960], sizes = '(min-width: 1024px) 33vw, 100vw',
  class: cls, loading = 'lazy', badge = 'Placeholder · update from Oliver', fetchpriority,
} = Astro.props;
const usable = widths.filter((w) => w <= src.width);
---
<div class:list={['photo', cls]}>
  {badge && (
    <span class="img-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M3 7h3l2-3h8l2 3h3v13H3z"/><circle cx="12" cy="13" r="4"/></svg>
      {badge}
    </span>
  )}
  <Image src={src} alt={alt} widths={usable.length ? usable : [src.width]} sizes={sizes} loading={loading} fetchpriority={fetchpriority} format="webp" quality={78} />
</div>

<style>
  .photo { position: relative; overflow: hidden; background: var(--char-700); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
